# Copy to .env; never commit real credentials.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=unimetric
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=unimetric
POSTGRES_CONNECT_TIMEOUT=3

# none | claude_cli | codex_cli | openai | anthropic | ollama
TEXT2SQL_PROVIDER=none

# Leave models blank to use each CLI's default model.
CODEX_MODEL=
CODEX_CLI_TIMEOUT=180
CLAUDE_MODEL=
CLAUDE_CLI_TIMEOUT=180
# Optional absolute executable path; do not include command arguments.
# CODEX_CLI_BIN=C:/path/to/codex.exe
# CLAUDE_CLI_BIN=C:/path/to/claude.cmd

# CLI text generation does not provide embeddings. Lexical RAG works without them.
EMBED_PROVIDER=none
EMBED_DIM=1024
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
